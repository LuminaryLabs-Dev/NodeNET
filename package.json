{
  "name": "@luminarylabs/nodenet",
  "version": "0.3.0",
  "description": "Bring the .NET toolchain and runtime into Node.js with a portable Node-native API and CLI.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "nodenet": "./bin/nodenet.js"
  },
  "files": [
    "src",
    "bridge",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:all": "npm test && npm run test:integration",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dotnet",
    "csharp",
    "nodejs",
    "esm",
    "runtime",
    "sdk",
    "interop",
    "avalonia",
    "msbuild",
    "nuget"
  ],
  "license": "MIT"
}

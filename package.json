{
  "name": "@luminarylabs/nodenet",
  "version": "0.3.2",
  "description": "Bring the .NET toolchain and runtime into Node.js with a portable Node-native API and CLI.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "nodenet": "./bin/nodenet.js"
  },
  "files": [
    "src",
    "bridge/**/*.cs",
    "bridge/**/*.csproj",
    "bin",
    "docs",
    "types",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:all": "npm test && npm run test:integration",
    "check": "node scripts/check.mjs",
    "test:display": "node scripts/display-proof.mjs --output artifacts/display",
    "test:avalonia": "node --test test/integration/avalonia.test.mjs",
    "example:paint": "node examples/framebuffer-paint/run.mjs",
    "example:notepad": "node examples/keyboard-notepad/run.mjs",
    "example:filters": "node examples/image-filter-lab/run.mjs",
    "example:studio": "node examples/self-contained-app/run.mjs",
    "validate:examples": "node scripts/validate-examples.mjs",
    "validate:local": "node scripts/local-validation.mjs",
    "validate:local:visible": "node scripts/local-validation.mjs --visible"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuminaryLabs-Dev/NodeNET.git"
  },
  "homepage": "https://github.com/LuminaryLabs-Dev/NodeNET#readme",
  "bugs": {
    "url": "https://github.com/LuminaryLabs-Dev/NodeNET/issues"
  },
  "author": "Luminary Labs",
  "keywords": [
    "dotnet",
    "csharp",
    "nodejs",
    "esm",
    "runtime",
    "sdk",
    "interop",
    "avalonia",
    "headless",
    "framebuffer",
    "msbuild",
    "nuget"
  ],
  "license": "MIT"
}
